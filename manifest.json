{
    "manifest_version": 3,
    "name": "Custom CSS Injector",
    "version": "1.0",
    "description": "Inject custom CSS on open site",
    "icons": {
        "16": "src/assets/icon.png",
        "48": "src/assets/icon.png",
        "128": "src/assets/icon.png"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/scripts/content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "src/popup.html"
    }
}